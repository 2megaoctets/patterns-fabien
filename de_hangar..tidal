        # hpffreq 35.0
        # gain 0.98
      ,
      listen (cF 1 "88") $
      degOffsetBy (3/9) (cF 0 "17") $
      (<| amp "0.4 ~ <0.6 ! [~@0.33 0.6]>") $
      s "Sd_fab_kickSourd" -- kick sourd
        # begin 0.0
        # end 1.0
        # sustain 1.0
        # atk 1e-05
        # rls 1.0
        # crv "-4.0"
        # mod1Start 0.2
        # mod1End 1.0
        # mod1Dur 0.012
        # mod2Start 0.3
        # mod2End 6.0
        # mod2Dur 0.0014
        # envmodAtk 0.002
        # envmodRls 0.26
        # envmodCrv "-12.0"
        # modSel 0.0
        # hiShelfSlope1 0.198
        # hiShelfSlope2 0.2
        # hiShelfGain 3.0
        # filterFreqModSel 0.0
        # filterMix 1.0
        # hpffreq 68.0
        # gain 1.08
      ,
      listen (cF 1 "89") $
      degOffsetBy (2/9) (cF 0 "18") $
      whenmod 4 3
      (mask "0 0 1") $
      fast "[1.5 <0.5 [0.5 1.5@2]>]" $
      (# pan (range 0.25 0.75 $ slow "3 1.5" cosine)) $
      (<| amp "[0.18 <0.3? [~@0.5 0.3] [~@0.25 0.3]> 0.24]*2") $
      s "Sd_fab_cheurley" -- hihat
        # begin 0.0
        # end 1.0
        # sustain 1.0
        # atk 0.0
        # rls 0.8
        # crv "-4.0"
        # freq 234
        # modffrqAdd "-1.2999999523163"
        # modffrqAmt 0.1
        # frq 0.0042
        # revmix 0.98
        # revmixmod 0.3
        # revroom 1.0
        # revdamp 0.01
        # revLpfFreq 4500.0
        # preDecay 0.3
        # hpfreq 867.0
        # bandfreq 1200.0
        # bandrq 1.0
        # banddb "-27.0"
        # distoMix 1.0
        # mod2freq 450.0
        # a 0.003
        # c 3.13
        # m 0.0019
        # xi 0.71
        # mul 42.6
        # add 0.0
        # lagTime 0.01
        # mix 0.15
        # carfreq 232.0
        # modfreq 0.7
        # pmindex 0.32
        # modphase 0.14
        # mul1 34.0
        # add1 0.0
        # gain 0.78
      ,
      listen (cF 1 "90") $
      degOffsetBy (4/9) (cF 0 "19") $
      whenmod "6 8" 5
      (|* noiseThr (slow (smooth "2 4") square * 2)) $
      sometimesBy 0.22
      (|+ filterRes 0.7) $
      (<| amp "0.4 ~ <0.3 ! [~@0.33 0.3]>") $
      s "Sd_fab_texturette" -- noise
          # begin 0.0
