resetCycles
-- clutchIn 1 24

globalGain = 1

do
  setcps 0.24
  -- resetCycles
  let chut = sometimesBy 0.21 (listen 0)
  d1 $ -- Kn tt %5 -- regFab_ambiance1 -- regFab_texturette
    stack [
      listen (cF 1 "87") $
      degOffsetBy (5/5) (cF 0 "16") $
      fast "8 4" $
      (<| amp ("{0.2@2 0.3 [0.1@2 0.3@0.5]}%1.25" * 2.2)) $
      s "Sd_fab_kickSourd" -- kick
        # begin 0.0
        # end 1.0
        # sustain 0.4
        # atk 0.1
        # rls 0.3
        # crv "-4.0"
        # freq 47
        # mod1Start 0.52
        # mod1End 1.0
        # mod1Dur (0.012 + (range 0 1 $ cF 0 "71"))
        # mod2Start 0.9
        # mod2End 18.0
        # mod2Dur 0.00014
        # envmodAtk 0.0012
        # envmodRls 0.06
        # envmodCrv "-4.0"
        # modSel 0.92
        # hiShelfSlope1 0.98
        # hiShelfSlope2 0.0092
        # hiShelfGain 3.0
        # filterFreqModSel 1
        # filterMix (1.0 + (range 0 "-0.5" $ cF 0 "72"))
        # hpffreq 45.0
        # gain 0.99
        # orbit 1
      ,
      listen (cF 1 "88") $
      degOffsetBy (4/5) (cF 0 "17") $
      sometimesBy 0.19
      (listen 0) $
      fast 2 $
      fast ("1 2" * "[0.5 2]") $
      (# pan (range 0.28 0.72 $ fast 2 sine)) $
      (<| amp "0.3 0.1 <0.4 ~> 0.5 _") $
      s "Sd_fab_hiPointe" -- hihat
        # begin 0.0
        # end 1.0
        # sustain 1.0
        # atk 0.0
        # rls 3.0
        # crv "-4.0 -14"
        # envmodLev1 0.0
        # envmodLev2 434.0
        # envmodLev3 4.0
        # envmodLev4 0.034
        # envmodLev 1
        # envmodTime1 0.034
        # envmodTime2 0.1
        # envmodTime3 0.0025
        # envmodTime "1 0.82 1"
        # envmodCurve1 "-4.0"
        # envmodCurve2 "-4.0"
        # envmodCurve3 "-4.0"
        # freqSwTime 0.82
        # inPow 12.0
        # reso 0.71
        # noiseAmp 0.8125
        # noiseFiltFreq 11810.0
        # noiseDur "1.2 0.4"
        # ringzAmp 0.814
        # ringzDcy ("0.0125 0.12" + (range 0 10 $ cF 0 "73"))
        # hpf 41
        # gain 0.745
      ,
      listen (cF 1 "89") $
      degOffsetBy (3/5) (cF 0 "18") $
      -- someCyclesBy 0.26
      -- (listen 0) $
      chut $
      (<| amp "0.24") $
      s "Sd_fab_ambiance1" -- ambiance
        # begin 0.0
        # end 1.0
        # sustain 5.0
        # atk 0.4
        # rls 2.0
        # crv "-12.0"
        # freq 346
        # ratioOffset 0.0
        # envFolAtk "<0.6 0.4 0.1>"
        # envFolRls 0.0031
        # foldTreshold 0.93
        # formantAmt 0.070794
        # formantatk 0.0
        # formantRls 7.0
        # formantCrv 4.0
        # formantCarrFreqMin 10.0
        # formantCarrFreqMax 30.0
        # formantLag 0.24
        # sinAmt "<0.5 0.2 0.95>"
        # sinAtk 0.4
        # sinRls 7.0
        # sinCrv "-2.0"
        # filterLag 0.98
        # revMix 0.2
        # revTime 1.0
        # revEarlyRefLev 0.0012
        # revTailLev 0.29
        # hpffreq 35.0
        # gain 0.98
      ,
      listen (cF 1 "90") $
      degOffsetBy (2/5) (cF 0 "19") $
      chut $
      someCyclesBy 0.3
      (
        (# cloudspitch "-2")
        . (# cloudsgain 2.5)
        . (# cloudssize "1 <0.6 0.4>")
        . (# cloudswet 0.5)
        . (# cloudsrvb "0.8 0.2")
        . (# cloudsdens 0.14)
        . (# cloudsmode 0)
        . (# cloudsfb 0.92)
        . (|* gain 1.08)
      ) $
      every 2
      (|* envmodTime2 "<12 12 [1 12 12]>") $
      (|<| amp "0.2@2 0.2 0.2 _") $
      s "Sd_fab_bassFold" -- bass
        # begin 0.0
        # end 1.0
        # sustain 1.0
        # atk 0.4
        # rls 0.6
        # crv "-3.0"
        # freqbus 1 "60 58"
        # phasorDirSel 0.0
        # envmodLev1 0.0
        # envmodLev2 0.2
        # envmodLev3 12.0
        # envmodLev4 0.0
        # envmodTime1 ("0.002 0.2" + (range 0 6 $ cF 0 "74"))
        # envmodTime2 "0.2 0.06 0.2"
        # envmodTime3 0.32
        # envmodCurve1 "-4.0"
        # envmodCurve2 2.0
        # envmodCurve3 "-8.0"
        # ienvOffset 0.56
        # modFoldAmt (0.937 + (range 0 "-0.6" $ cF 0 "77"))
        # distoMix 0
        # clipMix (0.98 + (range 0 "-0.5" $ cF 0 "75"))
        # lpffreq 430.0
        # hpffreq 20.0
        # bassMix 1.0
        # noiseSel 0.3
        # bpfFreq 710.0
        # bpfRq 0.03
        # granul 0.13
        # delayBase 0.00046
        # distoSel 0.5
        # textureMix 0
        # textureHpf 20.0
        # hpf 60
        # gain 0.93
        # orbit 2
    ] |* gain (0.96 * globalGain)

do
  setcps 0.86
  -- resetCycles
  d1 $ -- miami %4 -- regFab_miniRainStickRain -- regFab_microAbrasive 
    stack [
      listen (cF 1 "87") $
      degOffsetBy (5/4) (cF 0 "16") $
      sometimesBy (slow "<2 [1.5 0.5]>" "<[0 1@2] 0> 1@0.25 0 1@1.75")
      (fast "2 1.5 2 1.5" . (# noiseamt 0) . (# atk 0.02) . (# freq 82) . (|* gain 1.01)) $
      -- (<| amp "0.3?@0.5 0.5@1.5 [0.3@2 0.5?@0.5] ~") $
      (|<| amp "0.3@0.5 0.5@1.5 [0.3@2 0.5@0.5] ~") $
      s "Sd_fab_kickin" -- kick
        # begin 0.0
        # end 1.0
        # sustain 1.5 
        # atk 0.0001
        # rls (0.98 + (range 0 "-0.9" $ cF 0 "72"))
        # crv "-4.0"
        # freq 41
        # speed (1 + (range 0 "-0.9" $ cF 0 "71"))
        # phasorDir 0
        # phasorInv 0
        # phasorRate1 0.3
        # phasorRate2 1.3
        # envmodAtk 0.4
        # envmodRls 0.82
        # envmodCrv "-6.0"
        # noiseamt 0.839
        # parLag 0.002
        # parDecay 2.39
        # snapAmt 0.5
        # hiShelfFreq 241.0
        # hiShelfSlope 0.4
        # hiShelfDb 10
        # membrane2Amt 0
        # hpffreq 64
        # gain 0.99
        # orbit 1
      ,
      listen (cF 1 "88") $
      degOffsetBy (7/4) (cF 0 "17") $
      someCyclesBy 0.34
      (# freq (range 20 640 (slow "2 4" sine))) $
      whenmod "8 7" 6
      ((|* envmodTime "2 4") . (|+ strthreshold "-0.2") . (|+ strdur 10)) $
      spread ($) [
        ghost' 0.18,
        ghost' 0.16
      ] $
      sometimesBy 0.29
      (mask "0 0 0 [0 1] 0 0") $
      (<| amp "~@2 0.3@0.5 0.3@1.5") $
      s "Sd_fab_clickTambourin" -- snare
        # begin 0.0
        # end 1.0
        # sustain 1.0
        # atk 0.001
        # rls 1.0
        # crv "-4.0"
        -- # freq 240
        # envmodLev1 0.26
        # envmodLev2 1
        # envmodLev3 0.7
        # envmodLev4 0.2
        # envmodLev 1
        # envmodTime1 0.001
        # envmodTime2 0.8
        # envmodTime3 0.32
        # envmodTime 4.0
        # envmodCurve "-6.0"
        # modamt 1.0
        # freqMaxFactor 1.0
        # inPow1 2.0
        # inPreGain 0.6
        # res1 0.924
        # overdrive 0.4
        # type1 2.0
        # selFilter (0.3 + (range 0 0.7 $ cF 0 "73"))
        # inPow2 22.0
        # res2 1.96
        # type2 (fast "2 4" "<0 1.0>")
        # strMix (0.59 + (range 0 20 $ cF 0 "73"))
        # strthreshold 0.3
        # strdur 0.12
        # structpow 0.82
        # brightness 0.48
        # filtMix 0.31
        # gain 0.84
      ,
      -- listen (cF 1 "89") $
      -- degOffsetBy (2/4) (cF 0 "18") $
      -- (<| amp "<~@2.5 ~@2.5 ~@2.5 ~@2> <0.3@1.5 0.3@1.5 0.3@1.5 0.3@2>") $
      -- s "Sd_fab_feedbackLPG" -- golri
      --   # begin 0.0
      --   # end 1.0
      --   # sustain 1
      --   # atk 0.0001
      --   # rls 1.4
      --   # crv "-4.0"
      --   # modRate 1.18
      --   # modFb 1.23
      --   # controlScaleFact 1.0
      --   # envFolAtk 0.01
      --   # envFolRls 0.2
      --   # noiseAmt 0.0
      --   # noiseFact 0.33
      --   # lpgVcaModPow 1.0
      --   # feedbackAmt 0.99
      --   # feedbackHpf 20.0
      --   # hpffreq 20.0
      --   # gain 1.2
      -- ,
      listen (cF 1 "89") $
      degOffsetBy (3/4) (cF 0 "18") $
      someCyclesBy 0.3
      ((|+ freq (slow 0.5 ((sine * 2 - 1) * 80))) . (# accelerate 0.24)) $
      whenmod 6 4
      ((|+ textureFreq 100) . (|* amp 1.2)) $
      foldEvery [3, 4]
      ((# sinOctDown 2) . (# freq 50) . (|* amp 0.8)) $
      whenmod 6 "4 5"
      (append (s "[~ Sd_fab_basson]")) $
      s "Sd_fab_basson" -- bass
        # amp 0.4
        # begin 0.0
        # end 1.0
        # sustain 1.0
        # atk 0.001
        # rls 1.3
        # crv "-4.0"
        # freq 160
        # envmodLev1 0.0
        # envmodLev2 1.0
        # envmodLev3 1.0
        # envmodLev4 0.0
        # envmodLev 1.0
        # envmodTime1 0.001
        # envmodTime2 0.2
        # envmodTime3 0.32
        # envmodTime 1.0
        # envmodCurve "-4.0"
        # sinOctDown 10.0
        # sinAtk 0.12
        # sinDecay 1.0
        # sinPhase 0.0
        # sinhpf 70.0
        # textureAtk 0.01
        # textureRls 1.2
        # textureFreq 40.0
        # textureDisto 3.0
        # textureFfreqOffset 10.1
        # textureRq 0.98
        # texturehpf 20.0
        # filterMix (1.0 + (range 0 "-1" $ cF 0 "75"))
        # filterfreq (132.0 * (rangex 1 1000 $ cF 0 "74"))
        # flterFreqModRate 2.24
        # filterFreqModAmt 150.0
        # filterRes 0.4
        # revMix 0.3
        # revRt60 6.0
        # revlowFreq 4200.0
        # revlowRatio 0.25
        # revhiFreq 8400.0
        # revhiRatio 0.75
        # revearlyDiffusion 0.015
        # revlateDiffusion 0.5
        # revmodRate 0.52
        # revmodDepth 0.93
        # sinAmp 3.0
        # textureAmp 0.2
        # hpf 74
        # gain 0.94
        # orbit 2
      ,
      listen (cF 1 "90") $
      degOffsetBy (4/4) (cF 0 "19") $
      someCyclesBy 0.37
      (listen 0) $
      (# freq (smooth "120 320")) $
      every 4
      ((2/8) <~) $
      (<| amp "~@2 <0.3 ~> _") $
      s "Sd_fab_ambiance1" -- spectral
        # begin 0.0
        # end 1.0
        # sustain 1
        # atk 0.4
        # rls 0.6
        # crv "-2.0"
        # ratioOffset 0.12
        # envFolAtk 0.01
        # envFolRls 0.0031
        # foldTreshold (0.93 + (range 0 "-0.89" $ cF 0 "77"))
        # formantAmt 0.770794
        # formantatk 0.0
        # formantRls 0.8
        # formantCrv "-4.0"
        # formantCarrFreqMin 1.0
        # formantCarrFreqMax 30.0
        # formantLag 0.924
        # sinAmt 0.05
        # sinAtk 0.4
        # sinRls 7.0
        # sinCrv "-2.0"
        # filterLag 0.98
        # revMix "<1.0 0>"
        # revTime 8.0
        # revEarlyRefLev 0.0012
        # revTailLev 0.9
        # hpffreq 35.0
        # gain 1.05
        # orbit 2
    ] |* gain (1.07 * globalGain)

do
  setcps 0.62
  -- resetCycles
  d1 $ -- Lucky luke %4
    stack [
      listen (cF 1 "87") $
      degOffsetBy (7/4) (cF 0 "16") $
      fast "[1 3] [1 2]" $
      whenmod "6 5" "5 3"
      (|* modPhaseAmt (rangex 0.75 6 $ slow 2 saw)) $
      someCyclesBy 0.28
      (|+ modfreq (range "-0.75" 120 $ slow 4 rand)) $
      (<| amp "<[0.3@1.5 <0.5@1.5 0.5@1.5 ~@1.5> [~@2 0.5]] [0.3@1.5 0.5?@1.25 [~@2 0.5] ~@0.25]>") $
      s "Sd_fab_softkick1" -- kick
        # begin 0.0
        # end 1.0
        # sustain 1
        # atk 0.1
        # rls 0.18
        # crv "-4.0"
        # freq 50
        # modfreq 1.0
        # modPhaseAmt (0.4 + (range 0 4 $ cF 0 "72"))
        # modPhaseAtk 0.0001
        # modPhaseRls 0.008
        # modPhaseCrv (18.0 + (range 0 "-40" $ cF 0 "71"))
        # delaySin 0
        # clickMix 0.3
        # noiseDec 0.6
        # leak (0.4 * (range 1 10 $ cF 0 "71"))
        # distoMix 1.0
        # eqMix 0.52
        # hpffreq 50
        # gain 0.96
        # orbit 1
      ,
      listen (cF 1 "88") $
      degOffsetBy (6/4) (cF 0 "17") $
      someCyclesBy 0.15
      (listen "0 0 <1 0>") $
      someCyclesBy 0.22
      (|+ rls 0.1) $
      (|+ crv (range "-8" "1" $ slow 2 cosine)) $
      (|+ rngDelStn (range 0 0.028 tri)) $
      (|+ rngStn (range 0.01 0.4 $ fast "0.5 2"sine)) $
      (|+ rngStretch (range "-0.5" 0.5 saw)) $ 
      (|+ rngPos (range "-0.15" 0.85 $ fast "2 1" sine)) $ 
      (|+ rngLoss (range "-6" 6 $ slow "1 2" tri)) $ 
      (|+ resMix (range "-0.4" 0 tri)) $
      (|+ fxMix (range "-0.8" 0.2 rand)) $
      -- (<| amp (fast 2 $ "[~@2 0.4]*<2 1 2> 0.41")) $
      (<| amp (fast 2 $ "[~@3 0.4] [~@0.5 <0.4 <[~@0.25 0.4] [~@0.5 0.4]>>]")) $
      s "Sd_fab_bambouJox" -- snare
        # begin 0.0
        # end 1.0
        # sustain 1.0
        # atk 0.0001
        # rls (0.1 + (range 0 0.9 $ cF 0 "74"))
        # crv ("-4.0" + (range 0 "-20" $ cF 0 "73"))
        # rngDelStn 0.0
        # rngStn 0.01
        # rngStruct 0.175
        # rngBrightness 0.625
        # rngDamping 0.4
        # rngAccent 0.1
        # rngStretch 0.5
        # rngPos 0.15
        # rngLoss 10.15
        # resMix (1.0 + (range 0 "-1" $ cF 0 "74"))
        # decaytimea 13.0
        # feedBack 1.8
        # fxMix 0.8
        # gain (0.82 * (range 1 0.91 $ cF 0 "74"))
      ,
      listen (cF 1 "89") $
      degOffsetBy (2/4) (cF 0 "18") $
      someCyclesBy (fast 2 "0.28 0.36")
      ((|+ reso (range "-0.1" 0.2 sine)) . (|* amp 0.65)) $
      fast 2 $
      (|+ crv (range "-4" 4 perlin)) $
      (|+ envmodLev2 (range "-14" 134 saw)) $
      (|+ envmodCurve1 (range "-4" 4 cosine)) $
      (|+ envmodCurve2 (range "-4" 4 tri)) $
      (|+ envmodCurve3 (range "-4" 4 perlin)) $
      (|+ freqSwTime (range "-0.8" 0.8 sine)) $
      (|* ringzDcy (range 1 20 cosine)) $
      (# pan (range 0.2 0.8 $ slow "2 4 1.5" sine)) $
      (<| amp  "[~ [0.1 0.2] 0.14@0.5 [~ 0.2] 0.18@0.5]") $
      s "Sd_fab_hiPointe" -- hihat
        # begin 0.0
        # end 1.0
        # sustain 1.0
        # atk 0.0
        # rls 3.0
        # crv "-4.0"
        # envmodLev1 0.0
        # envmodLev2 234.0
        # envmodLev3 4.0
        # envmodLev4 0.034
        # envmodLev 1.0
        # envmodTime1 0.034
        # envmodTime2 0.1
        # envmodTime3 0.0025
        # envmodTime (1.1 + (range 0 "-0.6" $ cF 0 "75"))
        # envmodCurve1 "4" -- "4.0 -2 1"
        # envmodCurve2 "-4.0"
        # envmodCurve3 "-4.0"
        # freqSwTime 0.82
        # inPow 12.0
        # reso 0.71
        # noiseAmp 0.125
        # noiseFiltFreq 11810.0
        # noiseDur 1.2
        # ringzAmp 0.914
        # ringzDcy (0.0125 + (range 0 0.5 $ cF 0 "75"))
        # hpffreq 20.0
        # gain (0.88 + (range 0 "-0.14" $ cF 0 "75"))
      ,
      listen (cF 1 "90") $
      degOffsetBy (3/4) (cF 0 "19") $
      every (fast 4 "4 8")
      (|* rls 0.12) $
      whenmod 10 (5 + (range "-1" 2 $ slow 4 $ sine))
      (spread ($) [
        ((|+ envmodLev3 (range "-0.6" 0.6 $ saw)) . (# hpffreq 90)),
        (|+ fxFreqOffset "-10")
      ]) $
      (|* freq (fast 2 $ range "2 0.5" "0.5 2" cosine)) $
      (<| amp "~ 0.3@7") $
      s "Sd_fab_textural" -- texture
        # begin 0.0
        # end 1.0
        # sustain 2.0
        # atk 0.3
        # rls 3.8 -- (3.8 + (range 0 "-3.4" $ cF 0 "77"))
        # crv "-4.0"
        # freq 1230
        # envmodLev1 0.0
        # envmodLev2 1.0
        # envmodLev3 0.16
        # envmodLev4 1.0
        # envmodLev 1.0
        # envmodTime1 0.0004
        # envmodTime2 0.004
        # envmodTime3 0.0004
        # envmodTime 1.0
        # envmodCurve "-4.0"
        # fxMix (0.4 + (range 0 0.6 $ cF 0 "77"))
        # fxFreqOffset (14.0 + (range 0 20 $ cF 0 "77"))
        # hpffreq 92
        # gain 1.03
        # orbit 2
    ] |* gain (1 * globalGain)

