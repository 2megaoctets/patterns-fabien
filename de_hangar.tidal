      ,
      listen (cF 1 "89") $
      degOffsetBy (2/9) (cF 0 "18") $
      -- whenmod 4 3
      -- mask "0 0 1"
      someCyclesBy 0.7
      (mask "0 <0 1> 1") $
      fast "[1.5 <0.5 [0.5 1.5@2]>]" $
      (# pan (range 0.25 0.75 $ slow "3 1.5" cosine)) $
      (<| amp "[0.18 <0.3 [~@0.5 0.3] [~@0.25 0.3]> 0.24]*2") $
      s "Sd_fab_cheurley" -- hihat
        # begin 0.0
        # end 1.0
        # sustain 1.0
        # atk 0.0
        # rls 0.8
        # crv "-4.0"
        # freq 234
