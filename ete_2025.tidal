resetCycles
-- clutchIn 1 24

globalGain = 1

all id

do
  all (linger 0.5)
  d5 silence

all (slowSqueeze "2 16")

do -- c'est pas du livecoding gna gna gna %4
  setcps 0.6
  all id
  let thisGain = 1
  d1 $ -- kick low
    listen (cF 1 "87") $
    degOffsetBy (1/4) (cF 0 "16") $
    somecyclesBy 0.26
    (|+ modPhaseCrv (smooth "<-12 -20 12>")) $
    whenmod "<16 18>" "<14 16>"
    ((|* atk 3) . (|+ crv 12) . (|* gain 1.3). (# hpffreq 50)) $
    someCyclesBy 0.28
    (|+ modfreq (range "-0.75" 120 $ slow 4 rand)) $
    (<| amp "0.5 [0.3@1.5 <0.5 [<~@0.5 ~@0.5 ~@0.25> 0.5]> _]") $
    s "Sd_fab_softkick1"
      # begin 0.0
      # end 1.0
      # sustain 1
      # atk 0.1
      # rls 0.18
      # crv "-4.0"
      # freq 50
      # modfreq 340 -- 120
      # modPhaseAmt 12 -- 0.4
      # modPhaseAtk 0.0001 -- "0.0001 <0.0001 0.01>"
      # modPhaseRls "0.008 <0.001 0.008>"
      # modPhaseCrv 18.0
      # delaySin 0
      # clickMix 0.3
      # noiseDec 0.6
      # leak 0.4
      # distoMix 1.0
      # eqMix 0.52
      # hpffreq 58 -- 50
      # gain (0.96 * thisGain * globalGain)
      # orbit 1
  d2 $ -- kick hi
    listen (cF 1 "88") $
    degOffsetBy (3/4) (cF 0 "17") $
    whenmod "<16 18>" "<14 16>"
    (listen 0) $
    densityGap 0.5 $
    fast "[3 3 2]" $
    (|<| amp "0.3(<4 2>, 6, <0 <[1 1 0] 1>>)") $
    s "Sd_fab_kickin"
      # begin 0.0
      # end 1.0
      # sustain 0.4
      # atk 0.094
      # rls 0.98
      # crv "-16.0"
      # freq 91
      # phasorDir 0
      # phasorInv 0
      # phasorRate1 0.3
      # phasorRate2 1.3
      # envmodAtk 0.4
      # envmodRls 0.82
      # envmodCrv "-6.0"
      # noiseamt 0
      # parLag 0.002
      # parDecay 2.39
      # snapAmt 0.35
      # hiShelfFreq 241.0
      # hiShelfSlope 0.4
      # hiShelfDb 20
      # membrane2Amt 0
      # hpffreq 94 -- 44
      # gain (0.94 * thisGain * globalGain)
      # orbit 1
  d3 $ -- snare
    listen (cF 1 "89") $
    degOffsetBy (5/4) (cF 0 "18") $
    ((6/4) <~) $
    whenmod "<12 16>" "<10 15>"
    (|+ envmodLev (slow 4 cosine * 2 - 1)) $
    ghost' 0.2 $
    fast "2 <1 0.5>" $
    (<| amp "~@2 [<~ 0.2@0.5> 0.3]") $
    s "Sd_fab_rimmyRay"
      # begin 0.0
      # end 1.0
      # sustain 1.0
      # atk 0.0012
      # rls 0.046
      # crv "-4.0"
      # envmodLev1 0.0
      # envmodLev2 1.0
      # envmodLev3 0.1
      # envmodLev4 1.0
      # envmodLev 1.0
      # envmodTime1 0.0004
      # envmodTime2 0.004
      # envmodTime3 0.0004
      # envmodTime 1 -- "<10 1>"
      # envmodCurve "-4.0"
      # freqOffset 120.0
      # noiseThr 0.21
      # noisePow 20
      # brfRq 0.33
      # mix 0.46 -- "<0.78 0.46>"
      # gain (0.65 * thisGain * globalGain)
      # orbit 2
  d4 $ -- hi hat
    listen (cF 1 "90") $
    degOffsetBy (6/4) (cF 0 "19") $
    whenmod "<16 18>" "<14 16>"
    (listen 0) $
    (# pan (0.5 + (range "-0.16" 0.16 $ segment 36 $ (smooth ("0 0.95 0.25" * "0.25 0.0125") ~>) $ fast 6.8 cosine))) $
    fast "6 6 6 3" $
    (<| amp "0.1 0.2 0.2") $
    s "Sd_fab_whitehat Sd_fab_whitehat"
      # begin 0.0
      # end 1.0
      # sustain 0.022
      # atk 0.1
      # rls 0.001
      # crv "-8.0"
      # envmodLev1 0.0
      # envmodLev2 10.0
      # envmodLev3 1.0
      # envmodLev4 0.05
      # envmodLev5 0.05
      # envmodLev6 0.0
      # envmodLev 1
      # envmodTime1 0.004
      # envmodTime2 0.01
      # envmodTime3 0.05
      # envmodTime4 0.02
      # envmodTime5 0.005
      # envmodTime 0.7
      # envmodCurve 4.0
      # noisePow 12
      # combSwTime 0.18
      # bpfRq 1
      # crossoverFreq 7900.0
      # lpfSwTime 0.3
      # snapAmt 1
      # snapShape 0.19
      # snapSel 0
      # snapPow 2.0
      # hpffreq 20.0
      # gain (0.97 * thisGain * globalGain)
  d5 $ -- ambiance
    listen (cF 1 "91") $
    degOffsetBy (7/4) (cF 0 "20") $
    someCyclesBy 0.3
    (listen 0) $
    (<| amp "0.24@4") $
    s "Sd_fab_ambiance1"
      # begin 0.0
      # end 1.0
      # sustain 3.0
      # atk 0.4
      # rls 1
      # crv 2
      # freq 86
      # ratioOffset 1.1
      # envFolAtk 0.1
      # envFolRls 0.9
      # foldTreshold 1
      # formantAmt 0.532
      # formantatk 0.008
      # formantRls 2.0
      # formantCrv "-2"
      # formantCarrFreqMin 10.0
      # formantCarrFreqMax 30
      # formantLag 0
      # sinAmt 0.8
      # sinAtk "<0.4 0.5>"
      # sinRls "<7.0 4.0>"
      # sinCrv "<-2.0 2.0>"
      # filterLag "<0.98 10.98>"
      # revMix 0
      # revTime 1.0
      # revEarlyRefLev 0.0012
      # revTailLev 0.29
      # hpffreq 35.0
      # gain (1.04 * thisGain * globalGain)
  d6 $ -- bass
    listen (cF 1 "92") $
    degOffsetBy (2/4) (cF 0 "21") $
    ((3/4) ~>) $
    every "<5 6 4>"
    ((loopAt 0.5) . (|+ freq "<30 60 12> <20 8200>")) $
    foldEvery [4, 6]
    (|+ freq "10 70 8120") $
    fast "3 <2 0.5>" $
    (<| fxFreqOffset "1.8 10 0.9 14") $
    s "Sd_fab_textural"
      # begin 0.0
      # end 1.0
      # sustain 0.6
      # atk 0.3
      # rls 0.8
      # crv "-2.0"
      # freq 30
      # envmodLev1 0.0
      # envmodLev2 1.0
      # envmodLev3 0.16
      # envmodLev4 1.0
      # envmodLev "0.2 0.85"
      # envmodTime1 0.0004
      # envmodTime2 0.004
      # envmodTime3 0.0004
      # envmodTime 0.12
      # envmodCurve "-4.0"
      # fxMix 0.4
      # hpffreq 112 -- 92
      # gain (0.9 * thisGain * globalGain)
      # orbit 2

d3 $ -- snare
  listen (cF 1 "89") $
  degOffsetBy (5/4) (cF 0 "18") $
  (<| amp "~ [0.18 0.3](3, 6, 1)") $
  s "Sd_fab_rimmyRay"
    # begin 0.0
    # end 1.0
    # sustain 1.0
    # atk 0.0012
    # rls 0.06
    # crv "4.0"
    # freq 143
    # envmodLev1 0.0
    # envmodLev2 0.12
    # envmodLev3 0.96
    # envmodLev4 0.93
    # envmodLev 0.924
    # envmodTime1 0.0004
    # envmodTime2 0.004
    # envmodTime3 0.0004
    # envmodTime 0.21 -- "<10 1>"
    # envmodCurve "-24.0"
    # freqOffset 14
    # noiseThr 0.521
    # noisePow 12
    # brfRq 0.33
    # mix 0.46 -- "<0.78 0.46>"
    # gain (0.58 * globalGain)
    # orbit 2

do
  d1 $ -- kick low
    listen (cF 1 "87") $
    degOffsetBy (1/4) (cF 0 "16") $
    whenmod "<16 18>" "<14 16>"
    ((|* atk 3) . (|+ crv 12) . (|* gain 1.3)) $
