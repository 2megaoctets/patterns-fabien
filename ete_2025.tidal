))

do -- foudre de terrain %3
  setcps 0.96
  all id
  let thisGain = 1
  d1 $ -- kick
    listen (cF 1 "87") $
    degOffsetBy (1/3) (cF 0 "16") $
    whenmod "<8 18>" "<6 15>"
    ((|*| modAmt "1 0.6 2 0.8") . (|* gain 0.94)) $
    (|<| amp "0.1@0.5 [[~@0.5 0.2] <0.2 [~@0.5 0.2]>]") $
