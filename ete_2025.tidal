all id

all (linger "0.5 1 0.25" . bite 3 "<1 <1 1 0>> <2 0 1> <0 2>" . (|* rls (slow "<0.5 2>" $ smooth "0.12 0.52")))

all (fastappend (s "~@2.5"))

all (|* rls "0.12 0.3")

do -- boss of sandales %5
