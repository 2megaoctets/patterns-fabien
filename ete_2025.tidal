      # gain (0.76 * thisGain * globalGain)
  d4 silence
  d5 $ -- bass
    listen (cF 1 "91") $
    degOffsetBy (5/3) (cF 0 "20") $
    sometimesBy 0.24
    ((|+ distoSel (smooth "0.24 0.4")) . (|* gain 0.9)) $
    whenmod "<12 10>" "<10 7>"
    ((|+ filterMix (slow 2 $ slow "4 6" $ smooth "0 1")) . (|* filterFreq (rangex 0.5 5 $ slow 2 $ sine))) $
    foldEvery [4, 3]
    (|+ pulseCrv (smooth "0 -10")) $
    (*| amp "{[0.3@0.5 1@2](2, <5 5 3>)}%1.5") $
    s "Sd_fab_doubleBass"
      # amp 0.2
      # begin 0.0
      # end 1.0
      # sustain 1
      # atk 0.4
