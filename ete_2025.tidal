      # gain (1.48 * thisGain * globalGain)
      # orbit 1
  d2 $ -- snare
    listen (cF 1 "88") $
    degOffsetBy (2/3) (cF 0 "17") $
    whenmod 8 6
    (listen "0 1") $
    someCyclesBy 0.18
    (swingBy (2/6) 3) $
    ghost' 0.33 $
    (|<| amp "0.1@0.5 [0.2@2 [~@2 0.3]]@0.5 0.3@0.5") $
    s "Sd_fab_bambouJox"
      # begin 0.0
      # end 1.0
      # sustain 1.0
      # atk 0.0001
      # rls 0.1
      # crv "-4.0"
      # rngDelStn 0.0
      # rngStn 0.01
      # rngStruct 0.175
      # rngBrightness 0.625
      # rngDamping 0.4
      # rngAccent 0.02
      # rngStretch 0.5
      # rngPos 0.15
      # rngLoss 0.915
      # resMix 1.0
      # decaytimea 13.0
      # feedBack 1.8
      # fxMix 0.8
      # gain (1.02 * thisGain * globalGain)
  d3 $ -- hi hat
    listen (cF 1 "89") $
    degOffsetBy (4/3) (cF 0 "18") $
    someCyclesBy 0.7
    ((swingBy (4/6) 3) . (|* gain 1.06)) $
    (# pan (range 0.3 0.7 $ fast "<2 5> 4 3" cosine)) $
    (<| amp "[0.2@0.5 0.3(<1 <1 2>>, 4)]*3") $
    s "Sd_fab_cheurley"
      # begin 0.0
      # end 1.0
      # sustain "0.03 <1.0 0.42>"
      # atk 0.0
      # rls "<0.3 0.14> [0.14 <0.07 0.98>]"
      # crv "-4.0"
      # freq 234
      # modffrqAdd "-1.2999999523163"
      # modffrqAmt 0.1
      # frq 0.0042
      # revmix 0.98
      # revmixmod 0.3
      # revroom 1.0
      # revdamp 0.01
      # revLpfFreq 4500.0
      # preDecay 0.3
      # hpfreq 867.0
      # bandfreq 1200.0
      # bandrq 1.0
      # banddb "-27.0"
      # distoMix 1.0
      # mod2freq 450.0
      # a 0.003
      # c 3.13
      # m 0.0019
      # xi 0.71
      # mul 42.6
      # add 0.0
      # lagTime 0.01
