      # pulseCrv "-4.0"
      # sinFreqInterval 0.03
      # sinFreqDiv 7.0
      # distoSel 0
      # filterMix 0
      # filterFreq 220.0
      # filterModFreq 10.2
      # filterModAmt 20.0
      # filterRes 0.7
      # hpffreq 62.0
      # gain (1.28 * thisGain * globalGain)
      # orbit 2
  d6 silence

